# Copy to .env and fill in. .env is gitignored; never commit real values.

# ─── Knock (Notifications) ───
# All from the Knock dashboard, Development environment, Platform › API keys.
KNOCK_API_KEY=sk_test_...
KNOCK_PUBLIC_API_KEY=pk_test_...
# Shown only once when generated. Keep the PEM's newlines as \n inside quotes.
KNOCK_SIGNING_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# The in-app feed channel's id (a UUID), not its key. Integrations › Channels.
KNOCK_FEED_CHANNEL_ID=

# ─── Existing ───
# Unset: emails are written to .outbox/ instead of sent (app/lib/mailer.server.ts).
POSTMARK_SERVER_TOKEN=
DISCORD_INVITE_URL=
